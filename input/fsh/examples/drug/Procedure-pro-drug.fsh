Instance: pro-drug-1
InstanceOf: ProcedureTBDR
Title: "特定治療項目(一)"
Description: "依據特定治療項目-Procedure TB Drug Profile呈現用藥通報之特定治療項目範例"
Usage: #example
* status = #completed
* code.text = "A7"
* subject.reference = "Patient/pat-min"
* text.status = #generated
* text.div = "<div xmlns=\"http://www.w3.org/1999/xhtml\">
	<div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\">
        <p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-Procedure-tb-drug.html\">特定治療項目-Procedure TB Drug</a></p>
    </div>
    <p><b>status</b>：Completed</p>
    <p><b>特定治療項目代號(code.text)</b>：A7</p>
    <p><b>subject</b>：<a href=\"Patient-pat-min.html\">Patient/example</a></p>
</div>"

